# HTTP API
API_HOST=0.0.0.0
API_PORT=3000
# Optional global auth/rate limiting
# API_KEY=change-me
REQUIRE_AUTH=false
RATE_LIMIT_PER_MINUTE=60

# Core
RUST_LOG=info
DEFAULT_TIMEZONE=Asia/Jakarta
DATABASE_URL=postgres://siti:siti@localhost:5432/siti

# Text Generation
PROVIDER_TEXT_GENERATION=openrouter
MODEL_TEXT_GENERATION=google/gemini-3.5-flash-lite

# Image Generation (optional)
# PROVIDER_IMAGE_GENERATION=gemini
# MODEL_IMAGE_GENERATION=gemini-3.1-flash-lite-image

# Provider API Keys
OPENROUTER_API_KEY=
GEMINI_API_KEY=
TAVILY_API_KEY=
