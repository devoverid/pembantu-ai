# WhatsApp channel (Meta Cloud API webhook)
WA_HOST=0.0.0.0
WA_PORT=8080

# Meta webhook/app config
WHATSAPP_VERIFY_TOKEN=change-me
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v20.0

# Core
RUST_LOG=info
DEFAULT_TIMEZONE=Asia/Jakarta
DATABASE_URL=postgres://siti:siti@localhost:5432/siti

# Text Generation
PROVIDER_TEXT_GENERATION=openrouter
MODEL_TEXT_GENERATION=google/gemini-3.5-flash-lite

# Provider API Keys
OPENROUTER_API_KEY=
GEMINI_API_KEY=
TAVILY_API_KEY=
